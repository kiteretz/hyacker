---
import Layout from '@layouts/Layout.astro';

import SearchCount from '@components/SearchCount';
import SearchPageInput from '@components/SearchPageInput';
import SearchResults from '@components/SearchResults';
import SideLeft from '@components/SideLeft.astro';
---

<Layout title="検索結果">
  <section class="flex flex-1 flex-col">
    <div class="mb-px grid flex-1 grid-rows-[auto_1fr] gap-px">
      <SearchPageInput client:load />
      <div class="z-10 grid-tracks grid-rows-[auto_1fr] gap-px xl:grid-rows-1">
        <SideLeft title="Result" showCount stickyCount fillParent>
          <SearchCount slot="count" client:load />
        </SideLeft>
        <SearchResults client:load />
      </div>
    </div>
  </section>
</Layout>

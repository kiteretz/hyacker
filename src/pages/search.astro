---
import Layout from '@layouts/Layout.astro';

import SearchCount from '@components/SearchCount';
import SearchPageInput from '@components/SearchPageInput';
import SearchResults from '@components/SearchResults';
import SideLeft from '@components/SideLeft.astro';
---

<Layout title="Explorer hyacker " class="about">
  <section>
    <!--
      検索フォームを最上段に置き、その下に「Result 見出し＋投稿リスト」をラップした要素を配置する。
      デスクトップは下段のみ 2 カラム（左: Result 見出し / 右: 投稿リスト）。
    -->
    <div class="mb-px grid gap-px">
      <SearchPageInput client:load />
      <div class="grid xl:grid-cols-[16.625rem_1fr] xl:gap-px">
        <SideLeft title="Result" showCount>
          <SearchCount slot="count" client:load />
        </SideLeft>
        <SearchResults client:load />
      </div>
    </div>
  </section>
</Layout>

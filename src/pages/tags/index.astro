---
import Layout from '@layouts/Layout.astro';

import SideLeft from '@components/SideLeft.astro';

import { getPostsByTag } from '@libs/postsByTag';

const tags = await getPostsByTag();
---

<Layout title="タグ一覧">
  <section class="flex flex-1 flex-col">
    <div class="mb-px grid-tracks flex-1 max-xl:grid-rows-[auto_1fr] xl:gap-px">
      <SideLeft title="Tags" count={tags.length} showCount={true} fillParent />
      <div class="grid-tracks-col grid content-start bg-bg pb-40 xl:pb-0">
        {
          tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag.name)}/`}
              class:list={[
                'flex items-center justify-between border-b border-border bg-bg p-16 py-10 font-inter font-palt leading-none text-fg',
                'transition-colors duration-150',
                'xl:pr-24 xl:pl-8',
                'hover:bg-fg hover:text-bg',
                'focus-visible:bg-fg focus-visible:text-bg focus-visible:outline-none',
              ]}
            >
              <span class="text-16 font-medium tracking-tight">{tag.name}</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                viewBox="0 0 24 24"
                class="size-16 shrink-0"
              >
                <path stroke="currentColor" stroke-linejoin="bevel" stroke-width="2" d="M4 12h16m-8-8 8 8-8 8" />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

---
import Arrow from '@components/icon/Arrow';

interface Props {
  index?: number;
  href?: string;
  title: string;
  showCount?: boolean;
  count?: number;
  /** false にすると xl でビューポート基準（100svh）の高さを持たず、隣接コンテンツの高さに追従する */
  fullHeight?: boolean;
  /**
   * xl でビューポート基準の高さを頭打ちにするカード行数（fullHeight のときのみ有効）。
   * 列数がブレークポイントで変わるため、xl 帯と 2xl 帯それぞれの行数を渡す。
   */
  capRows?: { xl: number; '2xl': number };
  /**
   * true にすると xl でビューポート基準の最低高さを持たず、親グリッドの高さに追従する（最低 30rem。fullHeight のときのみ有効）。
   * コンテンツが短いページで、フッターまで含めてビューポートに収めるために使う。capRows とは併用しない。
   */
  fillParent?: boolean;
  /**
   * true にするとカウント表示の余白を、スロットで差し込むカウント（検索結果数）向けに調整する。
   * ビューポート下端への stick 自体は常に有効。
   */
  stickyCount?: boolean;
}

const {
  title,
  count,
  index,
  href,
  showCount = false,
  fullHeight = true,
  capRows,
  fillParent = false,
  stickyCount = false,
} = Astro.props;
const indexStr = index !== undefined ? String(index).padStart(2, '0') : '';
const countStr = count !== undefined ? String(count).padStart(3, '0') : '';

// 行数の変数は wrapper に持たせ、inner の min-h 計算で参照する
const capRowsStyle = fullHeight && capRows ? `--cap-rows-xl:${capRows.xl};--cap-rows-2xl:${capRows['2xl']}` : undefined;

const decorativeNumberClass =
  'hidden xl:absolute xl:bottom-0 xl:left-1/2 xl:block xl:-translate-x-1/2 xl:font-space-grotesk xl:leading-none xl:font-bold xl:lining-nums xl:slashed-zero xl:tabular-nums xl:opacity-10';
---

{
  /*
    xl 未満では -mb-px で margin box を border-b の 1px 分だけ縮める。sticky は margin box が
    コンテナ内に収まるよう押し上げられるため、セクション末尾で border-b がコンテナ外の
    区切り線（親の mb-px）に重なり、二重線にならない。
    縮めた 1px は親グリッドの gap-px で補う（非 sticky 時に後続要素が border-b に食い込まないように）。
    スクロール中にレイアウトを変えて二重線を消すと、iOS のオーバースクロールで高さが揺れてガタつく。
  */
}
<div
  class="max-xl:sticky max-xl:top-(--header-height) max-xl:z-50 max-xl:-mb-px max-xl:border-b max-xl:border-border xl:h-full"
  style={capRowsStyle}
>
  <div
    class:list={[
      'flex items-center justify-between bg-bg p-16 font-inter font-palt leading-none',
      'xl:h-full xl:flex-col xl:items-start xl:p-32 xl:pb-8',
      // xl ではセクションの高さいっぱいに伸ばし、見出し・カウントがその範囲で sticky する。
      // 以下の min-h はサイドバーがセクション（グリッド行）に与える最低限の高さ
      fullHeight && !fillParent && !capRows && 'xl:min-h-[max(calc(100svh-var(--header-height)),30rem)]',
      fullHeight &&
        !fillParent &&
        capRows &&
        'xl:min-h-[min(max(calc(100svh-var(--header-height)),30rem),calc(var(--cap-rows)*(var(--spacing-card)+1px)-1px))] xl:[--cap-rows:var(--cap-rows-xl)] 2xl:[--cap-rows:var(--cap-rows-2xl)]',
      fullHeight && fillParent && 'xl:min-h-480',
      // カウント / View More 領域の高さ（装飾数字の高さ）。見出しの mb と下の領域の -mt で共有する
      showCount
        ? 'xl:[--side-footer-h:--spacing(108)]'
        : indexStr
          ? 'xl:[--side-footer-h:--spacing(160)]'
          : 'xl:[--side-footer-h:--spacing(48)]',
      stickyCount && 'xl:pb-12!',
    ]}
  >
    {
      /*
        見出しは xl でヘッダー直下に stick する。mb（カウント領域の高さ + 20px）を持たせることで、
        セクション末尾ではカウントの 20px 上で押し出される。
      */
    }
    <h2
      class="text-32 leading-none font-semibold tracking-tighter xl:sticky xl:top-[calc(var(--header-height)+var(--spacing)*32)] xl:mb-[calc(var(--side-footer-h)+var(--spacing)*20)] xl:text-64 xl:writing-sideways-rl"
    >
      {title}
    </h2>
    {
      /*
        見出しの下〜下端までを占める領域。-mt で見出しの mb のうちカウント領域の高さ分を打ち消し、
        この領域の上端を見出しの 20px 下に置く。中のカウント / View More は xl でビューポート下端に stick し、
        この領域の内側（＝見出しの 20px 下からセクション下端まで）にとどまる。
        bottom-8 / bottom-12 は inner の pb-8 / pb-12 と揃える。
        装飾数字をサイドバーの左右中央に置くため、この領域と p は幅いっぱいに広げる（self-stretch）。
      */
    }
    <div
      class="max-xl:contents xl:-mt-(--side-footer-h) xl:flex xl:min-h-0 xl:flex-1 xl:flex-col xl:justify-end xl:self-stretch"
    >
      <p
        class:list={[
          'flex items-center gap-x-4 xl:sticky xl:min-h-(--side-footer-h) xl:items-end xl:pb-24',
          stickyCount ? 'pb-40! xl:bottom-12' : 'xl:bottom-8',
        ]}
      >
        {
          showCount ? (
            <slot name="count">
              <span class:list={['xl:text-108 xl:text-fg', decorativeNumberClass]}>{countStr}</span>
            </slot>
          ) : (
            href && (
              <a href={href} class="group contents">
                <span class="text-16 leading-none font-medium tracking-tight underline decoration-transparent underline-offset-2 transition group-hover:decoration-fg xl:text-24">
                  View More
                </span>
                <Arrow className="size-16 text-fg xl:size-24" />
                {indexStr && <span class:list={['xl:text-160 xl:text-fg', decorativeNumberClass]}>{indexStr}</span>}
              </a>
            )
          )
        }
      </p>
    </div>
  </div>
</div>

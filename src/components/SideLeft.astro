---
import Arrow from '@components/icon/Arrow';

interface Props {
  index?: number;
  href?: string;
  title: string;
  showCount?: boolean;
  count?: number;
  /** false にすると xl でビューポート基準（100svh）の高さを持たず、隣接コンテンツの高さに追従する */
  fullHeight?: boolean;
  /**
   * xl でビューポート基準の高さを頭打ちにするカード行数（fullHeight のときのみ有効）。
   * 列数がブレークポイントで変わるため、xl 帯と 2xl 帯それぞれの行数を渡す。
   */
  capRows?: { xl: number; '2xl': number };
  /**
   * true にすると xl でビューポート基準の高さを「上限」として扱い、親グリッドの高さに追従する（fullHeight のときのみ有効）。
   * コンテンツが短いページで、フッターまで含めてビューポートに収めるために使う。capRows とは併用しない。
   */
  fillParent?: boolean;
  /**
   * true にするとカウント表示の余白を、スロットで差し込むカウント（検索結果数）向けに調整する。
   * ビューポート下端への stick 自体は常に有効。
   */
  stickyCount?: boolean;
}

const {
  title,
  count,
  index,
  href,
  showCount = false,
  fullHeight = true,
  capRows,
  fillParent = false,
  stickyCount = false,
} = Astro.props;
const indexStr = index !== undefined ? String(index).padStart(2, '0') : '';
const countStr = count !== undefined ? String(count).padStart(3, '0') : '';

// 行数の変数は wrapper に持たせる（inner の inline style は sticky-sidebar.ts が書き換えるため）
const capRowsStyle = fullHeight && capRows ? `--cap-rows-xl:${capRows.xl};--cap-rows-2xl:${capRows['2xl']}` : undefined;

const decorativeNumberClass =
  'hidden xl:absolute xl:bottom-0 xl:left-1/2 xl:block xl:-translate-x-1/2 xl:font-space-grotesk xl:leading-none xl:font-bold xl:lining-nums xl:slashed-zero xl:tabular-nums xl:opacity-10';
---

<div
  class="max-xl:sticky max-xl:top-(--header-height) max-xl:z-50 max-xl:border-b max-xl:border-border"
  style={capRowsStyle}
  data-js-sticky-sidebar
>
  <div
    class:list={[
      'flex items-center justify-between bg-bg p-16 font-inter font-palt leading-none',
      'xl:flex-col xl:items-start xl:gap-y-20 xl:p-32 xl:pb-8',
      // fullHeight でない場合は隣接コンテンツ（カードリスト）の高さに追従する
      !fullHeight && 'xl:h-full',
      fullHeight && !fillParent && 'xl:h-[max(calc(100svh-var(--header-height)),30rem)]',
      fullHeight && fillParent && 'xl:h-full xl:max-h-[max(calc(100svh-var(--header-height)),30rem)] xl:min-h-[30rem]',
      // sticky-sidebar.ts が inline で書き込む height に負けないよう max-height で掛ける。1px は行間の gap-px
      fullHeight &&
        capRows &&
        'xl:max-h-[calc(var(--cap-rows)*(var(--spacing-card)+1px)-1px)] xl:[--cap-rows:var(--cap-rows-xl)] 2xl:[--cap-rows:var(--cap-rows-2xl)]',
      stickyCount && 'xl:pb-12!',
    ]}
    data-js-sticky-sidebar-inner
  >
    <h2 class="text-32 leading-none font-semibold tracking-tighter xl:text-64 xl:writing-sideways-rl">{title}</h2>
    {
      /*
      見出しの下〜下端までを占める領域。中のカウント / View More は xl でビューポート下端に stick し、
      この領域の内側（＝見出しのすぐ下からセクション下端まで）にとどまる。
      bottom-8 / bottom-12 は inner の pb-8 / pb-12 と揃えて、sticky-sidebar.ts による固定時と位置がずれないようにする。
      min-h は装飾数字（absolute）の高さ分で、見出し直下に来たときに数字が見出しへ重ならないようにする。
      装飾数字をサイドバーの左右中央に置くため、この領域と p は幅いっぱいに広げる（self-stretch）。
    */
    }
    <div class="max-xl:contents xl:flex xl:min-h-0 xl:flex-1 xl:flex-col xl:justify-end xl:self-stretch">
      <p
        class:list={[
          'flex items-center gap-x-4 xl:sticky xl:items-end xl:pb-24',
          stickyCount ? 'pb-40! xl:bottom-12' : 'xl:bottom-8',
          showCount ? 'xl:min-h-108' : indexStr && 'xl:min-h-160',
        ]}
      >
        {
          showCount ? (
            <slot name="count">
              <span class:list={['xl:text-108 xl:text-fg', decorativeNumberClass]}>{countStr}</span>
            </slot>
          ) : (
            href && (
              <a href={href} class="group contents">
                <span class="text-16 leading-none font-medium tracking-tight underline decoration-transparent underline-offset-2 transition group-hover:decoration-fg xl:text-24">
                  View More
                </span>
                <Arrow className="size-16 text-fg xl:size-24" />
                {indexStr && <span class:list={['xl:text-160 xl:text-fg', decorativeNumberClass]}>{indexStr}</span>}
              </a>
            )
          )
        }
      </p>
    </div>
  </div>
</div>

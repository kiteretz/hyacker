---
import SearchInput from '@components/SearchInput';

import { twMerge } from '@libs/twMerge';

export interface Props {
  class?: string;
  buttonClass?: string;
  iconClass?: string;
  inputClass?: string;
}

const { class: className, buttonClass, iconClass, inputClass } = Astro.props;
const isSearchPage = Astro.url.pathname === '/search/';
const shouldDisable = isSearchPage ? true : false;
---

<form action="/search/" method="get">
  <label class={twMerge('relative flex items-center', className)}>
    <span class="sr-only">サイト内検索</span>
    <SearchInput client:load className={inputClass} />
    <button
      class={twMerge(
        'absolute right-16 flex aspect-square w-32 shrink-0 cursor-pointer items-center justify-center',
        buttonClass,
      )}
      disabled={shouldDisable}
      aria-label="検索"
    >
      <svg
        class={twMerge('w-12', iconClass)}
        width="56"
        height="56"
        viewBox="0 0 56 56"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M40.7273 22.9091C40.7273 32.7498 32.7498 40.7273 22.9091 40.7273C13.0684 40.7273 5.09091 32.7498 5.09091 22.9091C5.09091 13.0684 13.0684 5.09091 22.9091 5.09091C32.7498 5.09091 40.7273 13.0684 40.7273 22.9091ZM37.2086 40.8082C33.2895 43.9437 28.3182 45.8182 22.9091 45.8182C10.2568 45.8182 0 35.5614 0 22.9091C0 10.2568 10.2568 0 22.9091 0C35.5614 0 45.8182 10.2568 45.8182 22.9091C45.8182 28.3182 43.9437 33.2895 40.8082 37.2086L55.2547 51.6544C56.2484 52.6487 56.2484 54.2604 55.2547 55.2547C54.2604 56.2484 52.6487 56.2484 51.6544 55.2547L37.2086 40.8082Z"
          fill="white"></path>
      </svg>
    </button>
  </label>
</form>
